# 复制本文件为 application.yml 后按需修改（application.yml 已被 .gitignore 排除）
# 数据库密码等敏感信息建议用环境变量注入，不要写死在文件里

server:
  port: 8081

spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:online_study}?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:}
  servlet:
    multipart:
      max-file-size: 50MB
      max-request-size: 50MB

mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
    map-underscore-to-camel-case: true

# JWT 配置（原代码中密钥硬编码在 JwtUtils.java，后续改造会迁移到这里）
jwt:
  secret: ${JWT_SECRET:}
  expiration: 86400000

# AI 能力配置（智能助教模块，后续阶段使用）
ai:
  api-key: ${AI_API_KEY:}
  base-url: ${AI_BASE_URL:https://api.deepseek.com}
  chat-model: ${AI_CHAT_MODEL:deepseek-chat}
  embedding-model: ${AI_EMBEDDING_MODEL:text-embedding-v3}
