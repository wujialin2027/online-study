<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>
    <groupId>com.online</groupId>
    <artifactId>study</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>online_study_backend</name>
    <description>Online Study Platform Backend</description>
    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.18</mybatis-plus.version>
        <jsqlparser.version>4.9</jsqlparser.version>
        <jjwt.version>0.12.6</jjwt.version>
        <spring-ai.version>2.0.2</spring-ai.version>
    </properties>
    <!-- Spring AI 2.0 用 BOM 统一版本：BOM 里管着几十个构件（chat / embedding / advisor / vector-store），
         单独给某个 starter 写版本号迟早会撞。2.0.2 = 2026-10-22 发布的最新 GA（2.1 还只有 RC）。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- 参数校验：@Valid / @NotBlank / @Min 等注解的实现（Hibernate Validator）。
             Boot 3 的 starter-web 已不再自带，必须显式引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP：操作日志切面（OperationLogAspect）需要 AspectJ 织入能力。
             Boot 4 起 starter 改名：spring-boot-starter-aop -> spring-boot-starter-aspectj
             （Boot 4.1.2 的 spring-boot-dependencies 里已无 aop 这个坐标，写旧名会直接报 version missing） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- MyBatis-Plus：Boot 4 专用 starter（Boot 4 换了 starter 坐标，
             boot3 版在 Boot 4 上会因自动配置注册方式变化而失效） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 分页插件 / 防全表更新插件：MP 3.5.9 起把依赖 jsqlparser 的两个拦截器
             （PaginationInnerInterceptor、BlockAttackInnerInterceptor）从 extension 拆到独立构件。
             包名没变，只是 jar 换了位置 —— 不引会报「找不到符号」，但编译期看不出原因。
             选 -4.9 后缀的版本：它适配 jsqlparser 4.9，与下面显式引入的版本一致。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser-4.9</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- SQL 解析器：分页插件与"防全表更新"插件的底层依赖。
             注意：MyBatis-Plus 从 3.5.6 起把 jsqlparser 改成了「可选依赖」，不再自动传递，
             而 PaginationInnerInterceptor / BlockAttackInnerInterceptor 运行时确实要用它。
             不显式引入的话，编译能过（编译期不解析），但启动或第一次分页查询时会抛
             NoClassDefFoundError: net/sf/jsqlparser/... —— 这是 3.5.6+ 最常见的踩坑点。 -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>${jsqlparser.version}</version>
        </dependency>

        <!-- MySQL 驱动：新坐标 com.mysql:mysql-connector-j，版本由 Boot 父 POM 管理 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JJWT 0.12 拆成三件套：api 编译期，impl/jackson 运行期 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring AI 2.0：OpenAI 兼容 starter。2.0 起各家 provider 合并成同一个 SDK，
             OpenAI 这一个 starter 就能接百炼（compatible-mode）、DeepSeek 等任何 OpenAI 兼容端点。
             ⚠️ 光加这一个依赖不会改变现有行为：application.yml 里把
             spring.ai.model.chat / embedding 都设成 none，模型自动配置就不生效，
             老链路（AiChatClient 直连）照旧跑。真正启用是在 P2-S3。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
